rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: logs
    // Fields:
    //   - uid: string (required) - User ID of the owner
    //   - url: string (required) - Target URL
    //   - date: string (required) - YYYY-MM-DD format
    //   - aspect: list (required) - List of strings
    //   - queries: string (optional)
    //   - before: string (required)
    //   - after: string (required)
    //   - note: string (optional)
    //   - createdAt: string (required) - ISO timestamp
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidLog(data) {
      return data.uid is string &&
             data.url is string && data.url.size() > 0 && data.url.size() < 2048 &&
             data.date is string && data.date.matches("^\\d{4}-\\d{2}-\\d{2}$") &&
             data.aspect is list && data.aspect.size() > 0 &&
             data.before is string && data.before.size() < 10000 &&
             data.after is string && data.after.size() < 10000 &&
             data.createdAt is string;
    }

    match /logs/{logId} {
      allow read: if isOwner(resource.data.uid);
      allow create: if isOwner(request.resource.data.uid) && isValidLog(request.resource.data);
      allow update: if isOwner(resource.data.uid) && isOwner(request.resource.data.uid) && isValidLog(request.resource.data);
      allow delete: if isOwner(resource.data.uid);
    }
  }
}
